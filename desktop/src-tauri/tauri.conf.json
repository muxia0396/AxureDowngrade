{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Axure Downgrade",
  "version": "0.1.7",
  "identifier": "com.axuredowngrade.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Axure Downgrade",
        "width": 1040,
        "height": 720,
        "minWidth": 840,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "bin/AxureDowngradeBridge.exe",
      "bin/K4os.Compression.LZ4.dll",
      "bin/K4os.Compression.LZ4.Legacy.dll"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
